<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Pull down the notification shade from the home screen -->
  <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
  <!-- Let the user uninstall apps from the launcher -->
  <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
  <!-- Control panel: show Wi-Fi / mobile data / Bluetooth on-off state (read-only, no prompts) -->
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
  <!-- Control panel brightness / auto-rotate. Special access the user grants in Settings, only if they want it -->
  <uses-permission android:name="android.permission.WRITE_SETTINGS" />
  <!-- Optional lock screen: show over the keyguard when the screen turns off. The full-screen
       notification is the fallback; "Display over other apps" is opt-in for maximum reliability. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

  <!-- Android 11+ package visibility: see every app that has a launcher icon -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <!-- Edge-panel clipboard: hands one picture at a time to the app the user sends it to (not exported). -->
    <provider
      android:name="expo.modules.launcher.ClipFileProvider"
      android:authorities="${applicationId}.clipfiles"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/lumo_clip_paths" />
    </provider>

    <!-- Share → "Lumo clipboard": saves shared text/pictures to the edge-panel clipboard. Invisible,
         no task of its own; it is switched off while the clipboard setting is off. -->
    <activity
      android:name="expo.modules.launcher.ClipShareActivity"
      android:label="Lumo clipboard"
      android:exported="true"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="image/*" />
        <data android:mimeType="text/plain" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="image/*" />
      </intent-filter>
    </activity>
  </application>
</manifest>
